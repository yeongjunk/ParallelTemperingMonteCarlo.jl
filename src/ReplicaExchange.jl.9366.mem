        - 
        -     exchange_status = ExchangeStatus(exchange_params)
        -     acceptance_status = AcceptanceStatus(K)
        -     walker_status = WalkerStatus(K)
        -     sample = 0
        -     partition = 0
        - 
        -     for sweep in 1:sampling_params.n_sweeps
