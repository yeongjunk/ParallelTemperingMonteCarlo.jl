        0         for (i, j) in edges
        0             1 <= i <= K || error("edge index out of range.")
        0             1 <= j <= K || error("edge index out of range.")
        0             i != j || error("self edge is not allowed.")
        0             !used[i] || error("edge group has duplicated vertex.")
        0             !used[j] || error("edge group has duplicated vertex.")
        - 
        0             used[i] = true
        0             used[j] = true
        0         end
        0     end
        - 
        0     return nothing
        - end
