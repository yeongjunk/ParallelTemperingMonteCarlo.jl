        - SamplingParams(n_sweeps::Int, sample_every::Int, partition_every::Int, K::Int) = SamplingParams(n_sweeps, sample_every, partition_every, collect(1:K))
        - 
        - function sample_replicas!(reps::AbstractReplicas, sampling_params::SamplingParams, exchange_params::ExchangeParams; rng = Random.GLOBAL_RNG)
        -     K = length(reps)
