        - function replica_exchanges!(reps::AbstractReplicas, edges::Vector{Edge}, n_attempts::Vector{Int}, n_accepts::Vector{Int}; rng = Random.GLOBAL_RNG)
        0     length(n_attempts) == length(edges) || error("n_attempts has wrong length.")
        0     length(n_accepts) == length(edges) || error("n_accepts has wrong length.")
        - 
        0     @inbounds for e in eachindex(edges)
        0         slot_i, slot_j = edges[e]
        - 
        0         E_i = getenergy(reps, slot_i)
        0         E_j = getenergy(reps, slot_j)
        0         beta_i = getbeta(reps, slot_i)
        0         beta_j = getbeta(reps, slot_j)
        - 
        0         n_attempts[e] += 1
        - 
        0         if try_exchange(E_i, E_j, beta_i, beta_j; rng=rng)
        0             swapwalkers!(reps, slot_i, slot_j)
        0             n_accepts[e] += 1
        -         end
        0     end
        - 
        0     return nothing
        - end
        - 
        - function try_exchange(E_i, E_j, beta_i, beta_j; rng = Random.GLOBAL_RNG)
        -     log_alpha = (beta_i - beta_j) * (E_i - E_j)
        - 
        -     log_alpha >= 0 && return true
        -     isfinite(log_alpha) || return false
        - 
        -     return log(rand(rng)) < log_alpha
        - end
