        - function replica_sweep!(reps::AbstractReplicas, sweep::Int, params::ExchangeParams, exchange_status::ExchangeStatus, acceptance_status::AcceptanceStatus, walker_status::WalkerStatus; rng = Random.GLOBAL_RNG)
        0     accepted = step!(reps)
        0     update_acceptance!(acceptance_status, accepted)
        - 
        0     if sweep % params.swap_every == 0
        0         g = mod1(sweep ÷ params.swap_every, length(params.edge_groups))
        0         replica_exchanges!(reps, params.edge_groups[g], exchange_status.n_attempts[g], exchange_status.n_accepts[g]; rng=rng)
        0         update_walker_status!(walker_status, getwalkerids(reps))
        -     end
        - 
        0     return nothing
        - end
