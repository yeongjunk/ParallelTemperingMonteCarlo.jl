        0         is_hot && (mon.last_endpoint[walker] = 1)
        - 
        0         is_cold && (mon.cold_visits[walker] += 1)
        0         is_cold && (mon.last_endpoint[walker] == 1) && (mon.endpoint_crossings[walker] += 1)
